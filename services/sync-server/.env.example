NODE_ENV=production
PORT=3040
# Must be a persistent volume — this directory holds the only off-device copy
# of every paired user's palettes.
DATA_DIR=/app/data
ALLOWED_ORIGINS=https://preprod-colorcatchers.netlify.app
# Only the rightmost x-forwarded-for value (appended by the reverse proxy) is
# trusted. Set to false when the server is reachable without a proxy in front.
TRUST_PROXY_HEADERS=true
# Set to false once your devices are paired: the instance stops minting
# accounts and the only unauthenticated write disappears.
PAIRING_ENABLED=true
PAIR_RATE_LIMIT_WINDOW_MS=3600000
PAIR_RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
# Bounds retained per-IP state; valid production range is 100-10000.
RATE_LIMIT_MAX_BUCKETS=10000
# Per-palette metadata document cap (bytes).
MAX_METADATA_BYTES=65536
# Per-photo upload cap (bytes).
MAX_ASSET_BYTES=26214400
# Whole-account quota (bytes). Default 2 GiB.
MAX_ACCOUNT_BYTES=2147483648
MAX_PALETTE_VERSIONS=5
TOMBSTONE_RETENTION_DAYS=30
