# Port the server listens on
PORT=3030

# Where JSONL log files are written (one file per day, e.g. 2026-05-18.jsonl)
LOG_DIR=./logs

# Comma-separated list of allowed Origin headers. POSTs from other origins are rejected (403).
# Example: https://paletcam.netlify.app,https://paletcam.example.com,http://localhost:3000
ALLOWED_ORIGINS=

# Rate limit: max requests per IP within RATE_LIMIT_WINDOW_MS
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Reject request bodies larger than this many bytes
MAX_BODY_BYTES=16384

# Dashboard credentials (HTTP Basic Auth on /dashboard and /logs).
# If either is empty, both routes return 503 (disabled).
DASHBOARD_USER=
DASHBOARD_PASSWORD=
