NODE_ENV=production
PORT=3030
PUBLIC_BASE_URL=https://logs.example.com
LOG_DIR=/var/lib/paletcam-logs
ALLOWED_ORIGINS=https://app.example.com,https://preprod.example.com
# Only the rightmost x-forwarded-for value (appended by the reverse proxy) is
# trusted. Set to false when the server is reachable without a proxy in front.
TRUST_PROXY_HEADERS=true
DASHBOARD_USER=replace-with-operator-user
DASHBOARD_PASSWORD=replace-with-at-least-16-random-characters
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
DASHBOARD_RATE_LIMIT_MAX=30
# Bounds retained per-IP state; valid production range is 100-10000.
RATE_LIMIT_MAX_BUCKETS=10000
# Includes the active disk write. New telemetry receives 503 with Retry-After
# when this bounded in-memory backlog is full.
LOG_WRITE_QUEUE_MAX_PENDING=1000
MAX_BODY_BYTES=16384
LOG_RETENTION_DAYS=30
MAX_LOG_FILE_BYTES=10485760
